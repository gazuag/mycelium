VITE_METERED_APP_DOMAIN=yourapp.metered.live
VITE_METERED_API_KEY=your-api-key-here
VITE_WEB_PUSH_PUBLIC_KEY=
VITE_WEB_PUSH_SENDER_URL=

# Server-only configuration for `python3 server_push.py`.
# Generate and provision a matching VAPID P-256 key pair out of band.
WEB_PUSH_BIND_HOST=127.0.0.1
WEB_PUSH_PORT=8444
WEB_PUSH_TLS_CERT_PATH=
WEB_PUSH_TLS_KEY_PATH=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.invalid
# Comma-separated exact HTTPS origins; keep empty until explicitly configured.
WEB_PUSH_ALLOWED_ORIGINS=
WEB_PUSH_CORS_ORIGINS=
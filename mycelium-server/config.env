# TLS certificate and private key file paths (not the key contents).
TLS_CERT_PATH=/path/to/server.crt
TLS_KEY_PATH=/path/to/server.key

# Server bind address and port.
SIGNAL_HOST=0.0.0.0
SIGNAL_PORT=8443

# Persistent discovery database. Relative paths are based on this directory.
DISCOVERY_DB_PATH=discovery.db

# Optional server limits. Uncomment to override defaults.
# MAX_DISCOVERY_POSTS=10000
# MAX_DISCOVERY_PROFILES=10000
# MAX_POST_SIZE=4096
# MAX_IDENTITY_PROFILE_SIZE=102400
# MAX_DISCOVERY_BATCH_SIZE=50
# SIGNAL_QUEUE_TTL_SECONDS=60
# MAX_QUEUED_SIGNALS_PER_CLIENT=32
# PEER_DISCOVERY_WINDOW_DAYS=30

  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.158.0"
  }

# Peer mode: social or hoarder.
MYCELIUM_MODE=hoarder

# Name published in the signed peer profile.
MYCELIUM_DISPLAY_NAME=Hyphae

# Description published in the signed identity object.
MYCELIUM_BIO=I'm an automatic cache node.

# Maximum serialized object-cache size and target WebRTC peer count.
MYCELIUM_CACHE_MB=4096
MYCELIUM_MAX_PEERS=16

# Relative paths are resolved from this distribution directory.
MYCELIUM_DATA_DIR=data

# Optional overrides:
# MYCELIUM_SIGNAL_URL=wss://discover.unfilter.ing:8443
# MYCELIUM_LOG_LEVEL=INFO
# MYCELIUM_AUTO_FOLLOW_BACK=false
# MYCELIUM_ICE_SERVERS='[{"urls":"stun:stun.example.invalid:3478"}]'